// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String       @id @default(uuid())
  clerkUserId   String       @unique 
  email         String       @unique 
  name          String?       
  imageUrl      String?      
  phone         String?  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          UserRole     @default(USER)
 memorials Body[] @relation("Body")
  cloth  Cloth[]  @relation("Cloth")
 screenshots Screenshot[]    

}

model Screenshot {
  id        String   @id @default(uuid()) 
  userId    String   
  url       String  
  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt 
  
  user      User     @relation(fields: [userId], references: [id]) 
}

model Body {
  id        String   @id @default(uuid())
  bodyColor String
  hair      String
  eye       String
  userId    String
  user      User     @relation("Body", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cloth {
  id            Int     @id @default(autoincrement())
  shirt         String?
  shirtTexture  String?
  skirt         String?
  skirtTexture  String?

  removeHair    Boolean @default(false)
  removeShirt   Boolean @default(false)
  removeSkirt   Boolean @default(false)

  userId        String  
  user          User    @relation("Cloth", fields: [userId], references: [id])
}


model Feed {
  id          String   @id @default(cuid())
  title       String
  description String
  imgUrl      String
  createdAt   DateTime @default(now())
}


enum UserRole {
  USER
  ADMIN
}
